<?xml version="1.0" encoding="utf-8"?>
<!-- Victorious Framework. Permissions are deliberately minimal: apps run inside this helper can only use what is declared here. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:glEsVersion="0x00020000" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".Box32Application"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="org.victoriousframework.victorlink64.box32.PROTOCOL"
            android:value="1" />

        <!-- Entry point for VictorLink64, in its own ":ui" process that never loads the engine. Exported so the main app can reach it; every request is checked
             against the caller's signing certificate inside the activity. -->
        <activity
            android:name=".HelperActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:process=":ui"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="org.victoriousframework.victorlink64.box32.action.PING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.victoriousframework.victorlink64.box32.action.RUN_APK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Runs in the app's default process, the only one (besides the sandbox processes) that loads the container engine.
             If the engine crashes natively while starting, only this process dies and the screen above can say so. -->
        <service
            android:name=".EngineService"
            android:exported="false" />
    </application>
</manifest>
