<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Victorious Framework: PC Streaming talks to Sunshine/GameStream hosts over plain HTTP
         (discovery and PIN pairing on port 47989) at arbitrary LAN addresses, which a domain list
         cannot express. Pairing then pins the host's certificate for the HTTPS calls. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
